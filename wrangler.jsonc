{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncafe-rss",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "FEED_KV" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
